# --- Database (used by the pipeline and by the API) ---
DB_NAME=geodata_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public

# --- Data locations (optional; default to raw_data/ and cleaned_data/ in the repo) ---
# RAW_DATA_DIR=D:/data/nasa/raw_data
# CLEANED_DATA_DIR=D:/data/nasa/cleaned_data

# --- Modeling ---
HIGH_FRP_THRESHOLD=10
MAX_WEATHER_DISTANCE_KM=100

# --- Docker / scheduling (docker-compose.yml) ---
API_PORT=8000
DB_PORT_HOST=5432
PIPELINE_INTERVAL_HOURS=24
PIPELINE_RUN_ON_START=1

# --- API ---
# auto = use PostgreSQL when reachable, otherwise fall back to the cleaned CSV files
DATA_BACKEND=auto
# CSV backend: sample file (python -m api.tools_make_sample) and row cap
# FIRES_SAMPLE_FILE=cleaned_data/fires_sample.csv
CSV_MAX_ROWS=500000
DECISION_THRESHOLD=0.5
CORS_ORIGINS=*
API_MAX_GEOJSON_FEATURES=50000
API_LOG_FILE=logs/api.log
LOG_LEVEL=INFO
