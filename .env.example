# --- Database (used by the pipeline and by the API) ---
DB_NAME=geodata_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=public

# --- Data locations (optional; default to raw_data/ and cleaned_data/ in the repo) ---
# RAW_DATA_DIR=D:/data/nasa/raw_data
# CLEANED_DATA_DIR=D:/data/nasa/cleaned_data

# --- Weather download (integration/NASA_POWER.py) ---
# grid (default): every place with fires, full fire date range, via the POWER regional endpoint
# point: the original single location (WEATHER_LATITUDE / WEATHER_LONGITUDE)
WEATHER_COVERAGE=grid
# Thinned grid spacing; must be multiples of 0.5 and 0.625. 1.0 x 1.25 keeps every fire within ~90 km of a point.
WEATHER_GRID_LAT_STEP=1.0
WEATHER_GRID_LON_STEP=1.25
# Pause between POWER requests in seconds (be polite to the public API)
WEATHER_REQUEST_PAUSE=1.0
# Optional overrides of the date range (YYYYMMDD); default is the fire data's range
# WEATHER_START=20250101
# WEATHER_END=20251231

# --- Modeling ---
HIGH_FRP_THRESHOLD=10
MAX_WEATHER_DISTANCE_KM=100
# 1 = train only on weather-matched fires (default); 0 = train on all fires, impute missing weather
REQUIRE_WEATHER_MATCH=1
# db (default) or csv (train from cleaned_data/ without PostgreSQL)
TRAINING_SOURCE=db
# MODEL_ARTIFACT_PATH=modeling/artifacts/high_frp_classifier.joblib
# Forest size: RF_N_ESTIMATORS=200 RF_MIN_SAMPLES_LEAF=20 RF_MAX_DEPTH=18
# Model served by the API (defaults to the pipeline's artifact)
MODEL_PATH=modeling/artifacts/high_frp_classifier_global.joblib

# --- Docker / scheduling (docker-compose.yml) ---
API_PORT=8000
DB_PORT_HOST=5432
PIPELINE_INTERVAL_HOURS=24
PIPELINE_RUN_ON_START=1

# --- Airflow (docker compose --profile airflow) ---
GEODATA_SCHEDULE=@daily
AIRFLOW_PORT=8080
# On Linux set this to your user id (id -u) so files Airflow writes stay yours
# AIRFLOW_UID=1000

# --- Assistant (POST /api/v1/ask) ---
# Needed for the assistant only; the rest of the API works without it.
ANTHROPIC_API_KEY=
ASSISTANT_ENABLED=1
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_ROUNDS=8
# Server-side refusal fallback to Anthropic's recommended model
ASSISTANT_FALLBACKS=1

# --- API ---
# auto = use PostgreSQL when reachable, otherwise fall back to the cleaned CSV files
DATA_BACKEND=auto
# CSV backend: sample file (python -m api.tools_make_sample) and row cap
# FIRES_SAMPLE_FILE=cleaned_data/fires_sample.csv
CSV_MAX_ROWS=500000
DECISION_THRESHOLD=0.5
CORS_ORIGINS=*
API_MAX_GEOJSON_FEATURES=50000
# Weather index and date range are rebuilt after this many seconds (or POST /api/v1/refresh)
API_CACHE_TTL_SECONDS=300
API_LOG_FILE=logs/api.log
LOG_LEVEL=INFO
